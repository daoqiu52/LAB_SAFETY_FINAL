# Physical K3=B1 confirmed by user, 2026-09-16.
set_pin_assignment { key3 } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# U33 external application Flash, NOT U39 configuration Flash.

set_pin_assignment { flash_cs_n } { LOCATION = P8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment { flash_sclk } { LOCATION = M9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

set_pin_assignment { flash_mosi } { LOCATION = P7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

set_pin_assignment { flash_miso } { LOCATION = N8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment { flash_wp_n } { LOCATION = P9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment { flash_hold_n } { LOCATION = R9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# SW1 -> RN38 -> SWKEY_1 -> U7A C8, 3.3V/GND slide switch.
set_pin_assignment { mode_sw } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }

# 6_EX_DEVICE.pdf / 2_FPGA.pdf: SWKEY_2=C7, BUZZER=H11 (active low).
set_pin_assignment { menu_sw } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { key_beep_n } { LOCATION = H11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLUP; }

# DS3231 module, board J1 pins 1(SCL),2(SDA),29(3V3),30(GND).
set_pin_assignment { rtc_scl } { LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { rtc_sda } { LOCATION = G11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
